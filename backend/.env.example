# Stocked Backend Configuration - Template Example
PORT=5001

# JWT_SECRET: Secret key for signing and verifying JWT tokens.
# Must be unique, strong, and kept private.
# Generation: Run `openssl rand -hex 64` to generate a secure secret.
JWT_SECRET=insert_your_unique_secure_jwt_secret_here

# ENCRYPTION_SECRET: Secret key for encrypting sensitive user data (e.g. API keys).
# Generation: Run `openssl rand -hex 32` to generate a unique 32-character hex secret.
# IMPORTANT: Do NOT reuse the JWT_SECRET value. Keep this key distinct and highly secure.
ENCRYPTION_SECRET=insert_your_unique_secure_encryption_secret_here

# --- Production (Railway + Neon) ---
# NODE_ENV: Set to 'production' on Railway. Leave unset or set to 'development' locally.
NODE_ENV=development

# DATABASE_URL: Neon Postgres connection string.
# Only required in production. Leave empty for local SQLite development.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins.
# Set this to your Vercel frontend URL on Railway.
# Example: https://stocked.vercel.app
# Leave empty locally (falls back to localhost:3000).
ALLOWED_ORIGINS=

PRICE_FEED_PROVIDER=manual
MARKET_API_KEY=
